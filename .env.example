# Shopify Admin API (same store already connected to this workspace)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local B2B customer/order database
DATABASE_URL="file:./dev.db"

# Session cookie signing secret (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# IfthenPay MB WAY (SPG)
IFTHENPAY_MBWAY_KEY=your-mbway-backoffice-key
# Your own secret, embedded in the callback URL you register with ifthenpay:
# https://<your-domain>/api/checkout/callback?key=<this value>
IFTHENPAY_ANTIPHISHING_KEY=change-me-to-another-long-random-string
